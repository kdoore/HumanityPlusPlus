    --purple: #534AB7;
    --red: #A32D2D;
    --green: #639922;
    --gray: #888780;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font-family: 'Inter', -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  header {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 24px 24px;
    text-align: center;
  }
  h1 {
    font-family: 'Source Serif 4', Georgia, serif;
    font-weight: 600;
    font-size: 30px;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }
  header p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 520px;
    margin: 0 auto;
  }
  nav.tabs {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin: 36px auto 0;
    max-width: 760px;
    padding: 0 24px;
    flex-wrap: wrap;
  }
  .tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-soft);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .tab:hover { border-color: var(--ink-soft); color: var(--ink); }
  .tab.active {
    border-color: var(--dot, var(--ink));
    color: var(--ink);
    background: #ffffff;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot, var(--ink-soft));
    flex-shrink: 0;
  }
  main {
    max-width: 780px;
    margin: 0 auto;
    padding: 32px 24px 24px;
  }
  .panel {
    display: none;
  }
  .panel.active {
    display: block;
    animation: fade 0.25s ease;
  }
  @keyframes fade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .diagram-frame {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px;
    overflow: hidden;
  }
  .diagram-frame svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .panel-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .panel-note {
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.5;
    max-width: 480px;
  }
  button.download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 8px;
    border: none;
    background: var(--ink);
    color: var(--cream);
